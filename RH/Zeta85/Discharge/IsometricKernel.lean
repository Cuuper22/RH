  Complex.re (∑ i : Fin (F.blockDim T),
    ∑ j : Fin (F.blockDim T),
      (∑ k : Fin (F.blockDim T),
        (∑ ρ₁ ∈ ZeroSide.ZI Z T,
          mixedBlockZeroSummand C T i k ρ₁) *
        (∑ ρ₂ ∈ ZeroSide.ZI Z T,
          mixedBlockZeroSummand C T k j ρ₂)) *
      (∑ l : Fin (F.blockDim T),
        (∑ ρ₃ ∈ ZeroSide.ZI Z T,
          mixedBlockZeroSummand C T j l ρ₃) *
        (∑ ρ₄ ∈ ZeroSide.ZI Z T,
          mixedBlockZeroSummand C T l i ρ₄)))

