/-- Kill shot for the finite algebra: after mixing columns first, the whole
raw quartic trace numerator is exactly the generic quartic generated by the
single symmetric projected pair kernel. -/
theorem cyclicQuarticNumerator_block_eq_mixedPairKernel
    {Z : ZeroConfig} {σ μ p : ℝ} {v : ℝ → ℝ}
    {F : QuarticGramFamily Z σ μ p v}
    (q : TrimmedMoment.Quartic)
    (C : RealData F) (T : ℝ) :
    QuarticTransfer.cyclicQuarticTraceNumerator q
        (IsometricBlock.block C.toData T) =
      mixedPairKernelQuarticNumerator q C T := by
  simp only [QuarticTransfer.cyclicQuarticTraceNumerator,
    mixedPairKernelQuarticNumerator,
    QuarticTransfer.pairKernelQuarticNumerator,
    cyclicTrace1_block_eq_mixedZero,
    cyclicTrace2_block_eq_mixedZero,
    cyclicTrace3_block_eq_mixedZero,
    cyclicTrace4_block_eq_mixedZero,
    mixedZeroCyclicTrace1_eq_tuple,
    mixedZeroCyclicTrace2_eq_tuple,
    mixedZeroCyclicTrace3_eq_tuple,
    mixedZeroCyclicTrace4_eq_tuple,
    mixedZeroTupleCyclicTrace1_eq_kernel,
    mixedZeroTupleCyclicTrace2_eq_kernel,
    mixedZeroTupleCyclicTrace3_eq_kernel,
    mixedZeroTupleCyclicTrace4_eq_kernel,
    mixedZeroKernelCyclicTrace1_eq_pairKernel,
    mixedZeroKernelCyclicTrace2_eq_pairKernel,
    mixedZeroKernelCyclicTrace3_eq_pairKernel,
    mixedZeroKernelCyclicTrace4_eq_pairKernel]

/-- The sole analytic boundary left after the mix-first finite algebra. -/
structure MixedPairKernelQuarticLowerBound
    {Z : ZeroConfig} {σ μ p : ℝ} {v : ℝ → ℝ}
    {F : QuarticGramFamily Z σ μ p v}
    (q : TrimmedMoment.Quartic) (C : RealData F) : Prop where
  block_dimension_pos :
    ∀ᶠ T in Filter.atTop, 0 < F.blockDim T
  eventually_gt :
    ∀ x : ℝ,
      x < μ * QuarticTransfer.limitQuarticScore q μ p →
      ∀ᶠ T in Filter.atTop,
        x < mixedPairKernelQuarticNumerator q C T /
          (Z.N T (2 * T) : ℝ)

/-- A lower bound for the projected pair kernel supplies exactly the
isometric weighted statistic consumed by every frozen rung. -/
theorem MixedPairKernelQuarticLowerBound.toIsometric
    {Z : ZeroConfig} {σ μ p : ℝ} {v : ℝ → ℝ}
    {F : QuarticGramFamily Z σ μ p v}
    {q : TrimmedMoment.Quartic} {C : RealData F}
    (h : MixedPairKernelQuarticLowerBound q C) :
    IsometricBlock.WeightedQuarticLowerBound q C.toData := by
  refine ⟨h.block_dimension_pos, ?_⟩
  intro x hx
  filter_upwards [h.eventually_gt x hx,
    h.block_dimension_pos] with T hT hm
  rw [IsometricBlock.weightedQuarticScore_eq_cyclic hm,
    cyclicQuarticNumerator_block_eq_mixedPairKernel]
  exact hT

