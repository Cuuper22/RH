def autocorrCross125 (u : ℝ) : ℝ :=
  polyEval125 autocorrCoeffCross125 u

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
theorem centered_cross_base125 (u x : ℝ) :
    base125 (x - u / 2) + base125 (x + u / 2) =
      polyEval125 (centeredCoeffCross125 u) x := by
  simp [base125, polyEval125, centeredCoeffCross125,
    Finset.sum_range_succ]
  ring

set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
theorem centered_integral_cross125 (u : ℝ) :
    (∫ x in (-(1 - u) / 2)..((1 - u) / 2),
      (base125 (x - u / 2) + base125 (x + u / 2))) = autocorrCross125 u := by
  rw [intervalIntegral.integral_congr (fun x _ => centered_cross_base125 u x),
    integral_polyEval125]
  simp [polyInt125, centeredCoeffCross125, autocorrCross125,
    polyEval125, autocorrCoeffCross125, Finset.sum_range_succ]
  ring

theorem integral_autocorr_cross125 (u : ℝ) :
    (∫ s in (-(1 : ℝ) / 2)..(1 / 2 - u), (base125 s + base125 (s + u))) =
      autocorrCross125 u := by
  calc
    _ = ∫ x in (-(1 : ℝ) / 2 + u / 2)..(1 / 2 - u + u / 2),
        (base125 (x - u / 2) + base125 (x + u / 2)) := by
      rw [← intervalIntegral.integral_comp_add_right
        (f := fun x => base125 (x - u / 2) + base125 (x + u / 2)) (u / 2)]
      apply intervalIntegral.integral_congr
      intro s hs
      congr 1 <;> ring
    _ = ∫ x in (-(1 - u) / 2)..((1 - u) / 2),
        (base125 (x - u / 2) + base125 (x + u / 2)) := by
      rw [show (-(1 : ℝ) / 2 + u / 2) = -(1 - u) / 2 by ring,
        show (1 / 2 - u + u / 2 : ℝ) = (1 - u) / 2 by ring]
    _ = autocorrCross125 u := centered_integral_cross125 u


